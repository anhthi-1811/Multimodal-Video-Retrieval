# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to exactly '.env'
# 2. Replace the placeholder values below with your actual credentials.
# 3. NEVER commit your real '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MONGODB CONFIGURATION
# ------------------------------------------------------------------------------
# Get your URI from MongoDB Atlas -> Database -> Connect -> Drivers
# Format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGO_URI="mongodb+srv://your_username:your_password@your_cluster_url/"

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Get your free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_google_gemini_api_key_here" 